# Copy this file to .env and fill in your values
# For production, set these in Vercel environment variables instead

DATABASE_URL=postgresql://user:password@host:5432/database
JWT_SECRET=your-jwt-secret-here

# Stripe (get keys at https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_MONTHLY=price_monthly
STRIPE_PRICE_ANNUAL=price_annual

# Resend (email)
RESEND_API_KEY=re_xxxxxxxxxx

# Web Push (browser notifications) — generate keys with: npx tsx src/lib/db/generate-vapid-keys.ts
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Base URL for checkout redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio (SMS verification)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_PHONE_NUMBER=+15551234567

# Routing backend (osrm or valhalla)
ROUTING_BACKEND=osrm
VALHALLA_URL=http://localhost:8002
OSRM_URL=https://router.project-osrm.org
